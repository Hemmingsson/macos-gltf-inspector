{
  "betterStatusBar.defaultColor": "statusBar.foreground",
  "betterStatusBar.loadNpmCommands": false,
  "betterStatusBar.reloadButton": null,
  "betterStatusBar.commands": [
    {
      "id": "glb.build",
      "label": "$(tools) Build",
      "command": "workbench.action.tasks.build",
      "tooltip": "dev.sh install → .build/ (+ /Applications on main). Does not open the app.",
      "color": "#d29922",
      "useVsCodeApi": true
    },
    {
      "id": "glb.runCube",
      "label": "$(rocket) Run cube",
      "command": "workbench.action.tasks.runTask",
      "args": ["dev: run cube"],
      "tooltip": "Build, launch cube.gltf, log to .build/logs/debug.log",
      "color": "#58a6ff",
      "useVsCodeApi": true
    },
    {
      "id": "glb.debug",
      "label": "$(debug-alt) Debug",
      "command": "workbench.action.debug.start",
      "tooltip": "Debug dropdown: RealityKit + fixture, or WebKit + fixture",
      "color": "#3fb950",
      "useVsCodeApi": true
    },
    {
      "id": "glb.logs",
      "label": "$(output) Logs",
      "command": "workbench.action.tasks.runTask",
      "args": ["dev: logs"],
      "tooltip": "Tail .build/logs/debug.log (or unified log stream)",
      "color": "#a371f7",
      "useVsCodeApi": true
    },
    {
      "id": "glb.stop",
      "label": "$(debug-disconnect) Stop",
      "command": "workbench.action.debug.stop",
      "tooltip": "Stop debugging",
      "color": "#f85149",
      "useVsCodeApi": true
    }
  ],
  "debug.onTaskErrors": "showErrors"
}
