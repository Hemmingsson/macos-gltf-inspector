{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "fixtureId",
      "type": "pickString",
      "description": "Test fixture",
      "options": [
        "cube",
        "tiny",
        "rigged",
        "boxAnimated",
        "lights",
        "cameras",
        "morph",
        "multiScene",
        "offcenter",
        "missingChannels",
        "invalid"
      ],
      "default": "cube"
    }
  ],
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug + fixture",
      "program": "${workspaceFolder}/.build/glTF Inspector.app/Contents/MacOS/glTF Inspector",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "dev: install",
      "env": {
        "GLTF_REPO_ROOT": "${workspaceFolder}",
        "GLTF_FIXTURE": "${input:fixtureId}",
        "GLTF_LOG_FILE": "${workspaceFolder}/.build/logs/debug.log",
        "GLTF_VERBOSE": "1"
      }
    },
    {
      "type": "lldb",
      "request": "attach",
      "name": "Attach",
      "program": "${workspaceFolder}/.build/glTF Inspector.app/Contents/MacOS/glTF Inspector"
    }
  ]
}
