{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "GLTFInspector (Debug)",
      "program": "/Applications/glTF Inspector.app",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build:install"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "GLTFInspector (Debug) + tiny.glb",
      "program": "/Applications/glTF Inspector.app",
      "cwd": "${workspaceFolder}",
      "args": ["${workspaceFolder}/TestModels/Fixture Models/tiny.glb"],
      "preLaunchTask": "build:install"
    },
    {
      "type": "lldb",
      "request": "attach",
      "name": "Attach glTF Inspector",
      "program": "/Applications/glTF Inspector.app"
    }
  ]
}
