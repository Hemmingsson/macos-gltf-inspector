{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xcodegen",
      "type": "shell",
      "command": "xcodegen generate",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "xcodebuild: GLBPreview",
      "type": "shell",
      "command": "DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodebuild -scheme GLBPreview -destination 'platform=macOS' -derivedDataPath /tmp/GLBPreview-dd build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": ["xcodegen"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
