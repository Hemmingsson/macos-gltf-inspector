{
  "watermark": false,
  "fonts": "system",
  "legend": false,
  "eyebrow": "",
  "motion": "none",
  "skin": "light",
  "type": "flowchart",
  "title": "Blank Quick Look or thumbnail",
  "subtitle": "Check the installed app, registered extensions, and glTF sidecar files.",
  "nodes": [
    {"id": "start", "label": "Blank preview", "shape": "terminal", "row": 0, "col": 1},
    {"id": "open", "label": "Open app once", "sub": "glTF Inspector.app", "row": 1, "col": 1},
    {"id": "installed", "label": "App in /Applications?", "shape": "decision", "row": 2, "col": 1},
    {"id": "move", "label": "Move app", "sub": "/Applications", "kind": "muted", "row": 2, "col": 0},
    {"id": "registered", "label": "Extensions registered?", "sub": "pluginkit -m -i <bundle id>", "shape": "decision", "row": 3, "col": 1},
    {"id": "refresh", "label": "Reset Quick Look", "sub": "qlmanage -r; qlmanage -r cache", "kind": "muted", "row": 3, "col": 0},
    {"id": "sidecars", "label": "Sidecars available?", "sub": ".bin and textures for .gltf", "shape": "decision", "row": 4, "col": 1},
    {"id": "keep", "label": "Keep sidecars beside file", "kind": "muted", "row": 4, "col": 0},
    {"id": "done", "label": "Try again", "shape": "terminal", "focal": true, "row": 5, "col": 1}
  ],
  "edges": [
    ["start", "open"],
    ["open", "installed"],
    ["installed", "move", "no"],
    ["installed", "registered", "yes", "primary"],
    ["move", "open", "then"],
    ["registered", "refresh", "no"],
    ["registered", "sidecars", "yes", "primary"],
    ["refresh", "open", "then"],
    ["sidecars", "keep", "no"],
    ["sidecars", "done", "yes", "primary"],
    ["keep", "done", "then"]
  ],
  "evidence": [
    {"id": "registration", "file": "scripts/verify.sh"},
    {"id": "bundle-ids", "file": "project.yml"},
    {"id": "sidecars", "file": "project.yml"}
  ]
}
